# Symbisol Backend Configuration (Solana)

# Server
PORT=4002
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Solana Network (devnet / testnet / mainnet-beta)
SOLANA_NETWORK=devnet

# Your Solana wallet public key (receives payments)
SERVER_ADDRESS=F2NdZXtsGVtECibLyhRJCA9qRnPgRc6W4Lmyg6eVH6g3

# Deployed Anchor program ID (devnet)
CONTRACT_ADDRESS=5383AVU3XCHu2L4dEVZVGtitekZEuaFBFoxgnFQJJmmB

# Solana RPC URL (defaults to devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent private key (hex — generate with: npx tsx agent/src/generate-wallet.ts)
