# ═══════════════════════════════════════════════════════════════
# SomniaSwarm — Autonomous Agent Swarm on Somnia
# ═══════════════════════════════════════════════════════════════

# ── Backend Server ──────────────────────────────────────────────
PORT=4002
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# ── Somnia Network ──────────────────────────────────────────────
# Options: testnet, mainnet
SOMNIA_NETWORK=testnet

# Private key of the agent wallet (hex with or without 0x prefix)
# Fund with STT testnet tokens from faucet
SOMNIA_PRIVATE_KEY=

# Somnia Agent Kit Contract Addresses (Testnet defaults)
SOMNIA_AGENT_REGISTRY=0x4d608e4de735db23A1c08BDacD8a37aa0b586c6A
SOMNIA_AGENT_MANAGER=0x686B8f061Ecb573917d0d3fda8EC07d6f8cccB44
SOMNIA_AGENT_EXECUTOR=0x157C56dEdbAB6caD541109daabA4663Fc016026e
SOMNIA_AGENT_VAULT=0x82f6dfC7E66B592B55B28020B86aC783e6a12B20

# ── Agent Client ────────────────────────────────────────────────
AGENT_SERVER_URL=http://localhost:4002

# ── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4002
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ── LLM (Groq) ──────────────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
